#!name = GoldBridge Push Probe · 本地验证版
#!desc = 黄金形态通通知痕迹本地采集（无 NAS）：badge/sync 推送锚点 ±90s 窗口 + 疑似信号接口命中即弹通知，详情进 Loon 日志。脚本走 GitHub raw 直链
#!author = @miloveu (https://github.com/miloveu/aieaapi)
#!date = 2026-11-24

# ============================================================
# 托管模式：脚本从 GitHub raw 拉取，无需手动粘贴。
# 安装：Loon → 插件 → 从 URL 安装 → 填本文件的 raw 地址：
#   https://raw.githubusercontent.com/miloveu/aieaapi/main/goldbridge-local.plugin
# 装好后确认：MitM/脚本总开关开启、CA 已完全信任、MitM over HTTP/2 开启。
# 判定：手机弹「🎯 MH 命中·疑似信号!」且正文含 trig/inv/t1/t2/t3 → 信号能抓到。
# ============================================================

[Script]
http-response ^https?:\/\/(api|goldapi|goldhub|goldturn|goldpulse|www)\.meihuagold\.com script-path=https://raw.githubusercontent.com/miloveu/aieaapi/main/mh_capture_local.js, tag=MH-Capture-Local, timeout=10, requires-body=true
cron "*/5 * * * *" script-path=https://raw.githubusercontent.com/miloveu/aieaapi/main/mh_dump_local.js, tag=MH-Dump, timeout=15

[MitM]
hostname = *.meihuagold.com
